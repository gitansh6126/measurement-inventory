# Line endings must not depend on each PC's git settings.
* text=auto
# Windows scripts: CRLF on every checkout (cmd.exe misreads LF-only .bat files).
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
# Applied migrations are checked byte for byte: never convert them.
app/api/prisma/migrations/** -text
# Binary
*.xlsx binary
*.png binary
*.jpg binary
*.ico binary
