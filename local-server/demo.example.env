# RS Inventory V3.1 - LOCAL SERVER, demo company (DEMO). Training and testing only.
# setup.ps1 copies this to demo.env and creates role + database rs_v31_demo_local.
# On the development PC demo.env points at rs_v31_demo on ports 3510 / 4510 instead.

APP_ENV=DEMO
RELEASE_VERSION=3.1.2
DEPLOYED_AT=CHANGE_ME_SET_BY_SETUP
DEMO_RESET_ENABLED=true

# Database name MUST contain "demo".
DATABASE_URL=postgresql://rs_v31_demo_local:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/rs_v31_demo_local?connection_limit=3&pool_timeout=10

SESSION_SECRET=CHANGE_ME_SESSION_SECRET
SESSION_IDLE_DAYS=5
SESSION_MAX_DAYS=30

PUBLIC_APP_URL=http://localhost:3310
TRUST_PROXY=false
PORT=4310
WEB_PORT=3310

STORAGE_ROOT=CHANGE_ME_SET_BY_SETUP

# Real company address for the top-bar switch button. Blank = no button.
SWITCH_APP_URL=http://localhost:3210

# Demo data can be recreated with demo:reset; backups are optional.
BACKUP_DIR=CHANGE_ME_SET_BY_SETUP
BACKUP_COPY_DIR=
BACKUP_KEEP_DAYS=7
