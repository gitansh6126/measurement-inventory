# RS Inventory V3.1 - LOCAL SERVER, real company (CLIENT_READY).
# setup.ps1 copies this to client.env (git-ignored, never in the ZIP) and fills every CHANGE_ME
# with random values. Read literally by common.ps1 and by node --env-file (no quotes, no
# spaces around =). Ports 3210 / 4210 so V3.1 runs next to V2 (3200 / 4200) during the test.

APP_ENV=CLIENT_READY
RELEASE_VERSION=3.1.1
DEPLOYED_AT=CHANGE_ME_SET_BY_SETUP
DEMO_RESET_ENABLED=false

# Local PostgreSQL on this PC. Database name must not contain "demo" or "test".
DATABASE_URL=postgresql://rs_v31_client:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/rs_v31_client?connection_limit=5&pool_timeout=10
# Scratch database for the weekly restore test (wiped before and after each run).
RESTORE_DB_URL=postgresql://rs_v31_client:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/rs_v31_client_restore

SESSION_SECRET=CHANGE_ME_SESSION_SECRET
SESSION_IDLE_DAYS=5
SESSION_MAX_DAYS=30

# The address used on this PC. Other devices are added at start-up (ALLOWED_ORIGINS, set by
# start.ps1 from the PC's LAN address and computer name).
PUBLIC_APP_URL=http://localhost:3210
# Plain http is accepted for CLIENT_READY only because the app stays inside the shop LAN.
# Never expose these ports to the internet (no router port-forwarding).
ALLOW_INSECURE_HTTP=true
# false on purpose: Next.js passes a client-sent X-Forwarded-For through unchanged.
TRUST_PROXY=false

# API listens on 127.0.0.1 only; the web server listens on WEB_PORT for the LAN.
PORT=4210
WEB_PORT=3210

# Uploaded product images (absolute path).
STORAGE_ROOT=CHANGE_ME_SET_BY_SETUP

# Demo company address for the top-bar switch button. Blank = no button.
SWITCH_APP_URL=http://localhost:3310

# "Forgot password" e-mails (Gmail app password). Blank = codes written to local-server\logs\.
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Backups (backup.ps1 / restore-test.ps1) ---
BACKUP_DIR=CHANGE_ME_SET_BY_SETUP
# A second copy OFF this PC's main disk (USB drive, other disk, Google Drive / OneDrive folder).
# Required for CLIENT_READY: the backup reports FAILED while this is blank.
BACKUP_COPY_DIR=
BACKUP_KEEP_DAYS=30

# --- Monitoring (optional; blank = off) ---
# Ping URLs of a free uptime service such as https://healthchecks.io (one check each). The
# service alerts you (e-mail / Telegram / WhatsApp) when a ping is missing or <url>/fail arrives.
# Only a short status text is sent, never shop data.
# MONITOR_PING_URL: every 5 minutes by the watchdog while the app answers (alert = app or PC down).
# MONITOR_BACKUP_PING_URL: after every nightly backup. MONITOR_RESTORE_TEST_PING_URL: every Sunday.
MONITOR_PING_URL=
MONITOR_BACKUP_PING_URL=
MONITOR_RESTORE_TEST_PING_URL=
# Log files not written for this many days are deleted (watchdog + nightly backup).
LOG_KEEP_DAYS=30
