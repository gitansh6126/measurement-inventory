{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "es2022"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next-display/types/**/*.ts",
    ".next-local-demo-dev/types/**/*.ts",
    ".next-local-demo/types/**/*.ts",
    ".next-uiux/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-enter/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
