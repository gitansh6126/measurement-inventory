# Copy to .env for local development. Never commit a populated .env.
# CLIENT_READY and DEMO values live in the VPS secret store, not in files here.
APP_ENV=DEMO
RELEASE_VERSION=0.1.0-dev
DEPLOYED_AT=2026-10-13T00:00:00+05:30
# Database name must contain "demo" for DEMO and "test" for TEST (enforced at startup).
DATABASE_URL=postgresql://rs_v3:CHANGE_ME@127.0.0.1:5432/rs_v31_demo?connection_limit=5&pool_timeout=10
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=CHANGE_ME_TO_A_RANDOM_VALUE_OF_AT_LEAST_32_CHARS
SESSION_IDLE_DAYS=5
SESSION_MAX_DAYS=30
PUBLIC_APP_URL=http://localhost:3000
PORT=4000
TRUST_PROXY=false
DEMO_RESET_ENABLED=true
# Optional first-admin bootstrap. Set both only when intentionally provisioning a fresh DB.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin
ADMIN_COMPANY_NAME=RS Machinery
# Gmail SMTP; until credentials are set, password-reset codes are written to the API log.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Optional comma-separated browser origins for local/LAN access.
ALLOWED_ORIGINS=
# Other environment's address for the top-bar switch button (blank locally = no button).
SWITCH_APP_URL=

# Integration tests only: a separate database whose name contains "test".
TEST_DATABASE_URL=postgresql://rs_v3:CHANGE_ME@127.0.0.1:5432/rs_v31_test
